# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and stays on your machine.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Lead delivery
LEADS_TO_EMAIL=
LEADS_CC_EMAILS=

# Sender (use Resend's onboarding@resend.dev until you verify gleampro.ca in Resend)
LEADS_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Optional — leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=
